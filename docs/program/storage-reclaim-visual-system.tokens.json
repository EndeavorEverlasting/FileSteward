  "disposition_token_map": {
    "HUMAN_REVIEW": "state-review",
    "UNKNOWN": "state-unknown",
    "PROTECTED": "state-protected",
    "KEEP_PROVEN": "state-keep",
    "RECLAIM_PROVEN": "state-reclaim"
  },
  "authorization_visual": {
    "UNAPPROVED": {"tone": "neutral", "icon": "lock"},
    "APPROVED_FOR_ACTION": {"tone": "accent", "icon": "signed-check"},
    "APPLIED": {"tone": "accent", "icon": "signed-check"},
    "VERIFIED": {"tone": "strong-neutral", "icon": "confirmation"}
  },
  "invariants": [
    "magnitude_never_implies_actionability",
    "evidence_color_never_implies_authorization",
    "selection_never_implies_approval",
    "reclaim_green_never_used_for_authorization",
    "state_never_color_alone",
    "no_destructive_controls_in_initial_visualization",
    "receipt_text_literal_only"
  ]
