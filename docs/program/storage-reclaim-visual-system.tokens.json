{
  "schema_version": "filesteward.visual-system.tokens/v1",
  "contract_id": "storage-reclaim-visual-system",
  "color_scheme": "light dark",
  "typography": {
    "sans": [
      "Segoe UI Variable Text",
      "Segoe UI Variable",
      "Segoe UI",
      "system-ui",
      "-apple-system",
      "BlinkMacSystemFont",
      "sans-serif"
    ],
    "mono": [
      "Cascadia Mono",
      "Cascadia Code",
      "Consolas",
      "ui-monospace",
      "monospace"
    ],
    "scale": {
      "display": {"size_px": 28, "line_height_px": 36, "weight": 600},
      "title_lg": {"size_px": 20, "line_height_px": 28, "weight": 600},
      "title": {"size_px": 16, "line_height_px": 24, "weight": 600},
      "body": {"size_px": 14, "line_height_px": 20, "weight": 400},
      "body_strong": {"size_px": 14, "line_height_px": 20, "weight": 600},
      "small": {"size_px": 12, "line_height_px": 16, "weight": 400},
      "small_strong": {"size_px": 12, "line_height_px": 16, "weight": 600},
      "micro": {"size_px": 11, "line_height_px": 14, "weight": 500}
    },
    "min_body_px": 12,
    "tabular_nums": true
  },
  "space": {
    "unit_px": 4,
    "scale_px": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48
    },
    "pane_padding_desktop_px": 16,
    "pane_padding_compact_px": 12,
    "page_edge_px": [20, 24],
    "row_height_min_px": 40,
    "row_height_preferred_px": 44,
    "pointer_target_min_px": 40,
    "pointer_target_preferred_px": 44
  },
  "radius_px": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 14,
    "pill": 999,
    "treemap_max": 4
  },
  "shadow": {
    "light": {
      "sm": "0 1px 2px rgba(0,0,0,.06)",
      "md": "0 4px 16px rgba(0,0,0,.08)"
    },
    "dark": {
      "sm": "0 1px 2px rgba(0,0,0,.20)",
      "md": "0 4px 16px rgba(0,0,0,.28)"
    }
  },
  "motion": {
    "easing": "cubic-bezier(.2, 0, 0, 1)",
    "hover_ms": [100, 140],
    "selection_ms": [120, 160],
    "pane_ms": [160, 200],
    "treemap_zoom_max_ms": 200,
    "reduced_motion_ms": 0.01
  },
  "breakpoints_px": {
    "wide_min": 1440,
    "standard_min": 1180,
    "medium_min": 800,
    "narrow_max": 799
  },
  "shell_grid": {
    "desktop_min_width_px": 1280,
    "desktop_min_height_px": 720,
    "columns": "minmax(260px, 320px) minmax(480px, 1fr) minmax(320px, 400px)",
    "navigator_share": "25%",
    "treemap_share": "45-50%",
    "inspector_share": "25-30%"
  },
  "treemap": {
    "outer_padding_px": 8,
    "gap_normal_px": 2,
    "gap_dense_px": 3,
    "min_label_dimension_px": 3,
    "selection_outline_px": 3
  },
