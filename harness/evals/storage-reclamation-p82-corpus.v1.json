      "kind": "application",
      "fixture": "user-scoped Squirrel/Electron installation with Update.exe and uninstall registration",
      "expected": [
        "PROTECTED",
        "UNINSTALL_APPLICATION or REPAIR_APPLICATION",
        "raw_delete=false"
      ]
    },
    {
      "id": "APP-BROKEN-REGISTRATION",
      "kind": "application",
      "fixture": "installed-app registration survives but updater/uninstaller path is missing; Wispr archetype",
