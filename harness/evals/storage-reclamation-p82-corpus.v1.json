{
  "schema_version": "filesteward.storage-reclamation-p82-corpus/v1",
  "purpose": "Adversarial oracle for capacity recovery without application/repository damage.",
  "expected_global_invariants": [
    "No protected/serviceability/unique fixture may become RAW_DELETE_REGENERABLE_ARTIFACT.",
    "Unknown ownership never becomes RECLAIM_PROVEN.",
    "A stale ownership graph revision fails permanent-delete preflight.",
    "Capacity urgency changes ordering only; it does not weaken gates."
  ],
  "cases": [
