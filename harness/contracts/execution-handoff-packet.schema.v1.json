{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filesteward.execution-handoff-packet/v1",
  "title": "FileSteward execution handoff packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "sprint_id",
    "lane_id",
    "role",
    "canonical_plan_ref",
    "contract_refs",
    "provider_base_sha",
    "provider_head_sha",
    "local_head_sha_or_unknown",
    "completed_facts",
    "remaining_work",
    "owned_mutation_surfaces",
    "forbidden_surfaces",
    "dependencies",
    "external_prerequisites",
    "proof_receipts",
    "proof_ceiling",
    "unresolved_review_threads",
    "private_evidence_refs",
    "blocked_judgment_gap",
    "autonomy_gap",
    "exact_next_action",
    "return_contract"
  ],
  "properties": {
    "protocol_version": {
      "const": "filesteward.execution-handoff-packet/v1"
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "lane_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "canonical_plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "contract_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "provider_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "local_head_sha_or_unknown": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "const": "UNKNOWN_NOT_OBSERVED"
        }
      ]
    },
    "completed_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact",
          "evidence",
          "proof_state"
        ],
        "properties": {
          "fact": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "proof_state": {
            "enum": [
              "DESIGNED",
              "CONTRACT_ENCODED",
              "IMPLEMENTED",
              "LOCALLY_VALIDATED",
              "PROVIDER_VALIDATED",
              "MERGED",
              "LIVE_OBSERVED",
              "APPLIED",
              "VERIFIED"
            ]
          }
        }
      }
    },
    "remaining_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "work_id",
          "action",
          "depends_on",
          "acceptance"
        ],
        "properties": {
          "work_id": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owned_mutation_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "external_prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_review_threads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "thread_id",
          "materiality",
          "status"
        ],
        "properties": {
          "thread_id": {
            "type": "string",
            "minLength": 1
          },
          "materiality": {
            "enum": [
              "MATERIAL",
              "NON_MATERIAL",
              "UNKNOWN"
            ]
          },
          "status": {
            "enum": [
              "UNRESOLVED",
              "REPAIRED_PENDING_REFRESH",
              "DISPROVEN_PENDING_REFRESH"
            ]
          }
        }
      }
    },
    "private_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blocked_judgment_gap": {
      "oneOf": [
        {
          "const": "NONE"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_judgment",
            "canonical_owner",
            "why_required"
          ],
          "properties": {
            "missing_judgment": {
              "type": "string",
              "minLength": 1
            },
            "canonical_owner": {
              "type": "string",
              "minLength": 1
            },
            "why_required": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "autonomy_gap": {
      "oneOf": [
        {
          "const": "NONE"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_adapter",
            "evidence",
            "repair_route"
          ],
          "properties": {
            "missing_adapter": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "repair_route": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "exact_next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "action",
        "owner",
        "can_execute_without_operator"
      ],
      "properties": {
        "phase": {
          "enum": [
            "RECOVER",
            "PARTITION",
            "DISPATCH",
            "EXECUTE",
            "PROVE",
            "REVIEW",
            "CONVERGE",
            "CONTINUE"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "can_execute_without_operator": {
          "type": "boolean"
        }
      }
    },
    "return_contract": {
      "type": "string",
      "minLength": 1
    }
  }
}
